# Produção on-premise: usar valores próprios da imobiliária.
APP_DOMAIN=imoveis.example.com.br
PEPIUS_VERSION=0.1.0
ACME_EMAIL=infra@example.com.br
NEXT_PUBLIC_APP_URL=https://imoveis.example.com.br
NEXT_PUBLIC_SUPABASE_URL=https://api.imoveis.example.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-local-supabase-anon-key
SUPABASE_INTERNAL_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-local-supabase-service-role-key
PEPIUS_TENANT_ID=replace-with-the-provisioned-agency-uuid
LEAD_RATE_LIMIT_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
LICENSE_TRUSTED_PUBLIC_KEYS_JSON={}
PEPIUS_LICENSE_API_URL=https://licenses.pepius.com
LICENSE_STATE_DIR=/var/lib/pepius/license-state
LICENSE_DEV_BYPASS=false
LICENSE_CONTROL_PLANE_ENABLED=false

# Compose: rede local do stack Supabase self-hosted.
SUPABASE_DOCKER_NETWORK=supabase_default
