FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src/lib/licensing/domain.ts ./src/lib/licensing/domain.ts
COPY scripts/license-agent.mjs ./scripts/license-agent.mjs
COPY scripts/license.mjs ./scripts/license.mjs
COPY scripts/agency-provision.mjs ./scripts/agency-provision.mjs
CMD ["node", "--experimental-strip-types", "scripts/license-agent.mjs"]
